rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isConstAdmin() {
      return signedIn() && (
        request.auth.token.email in ['admin@efteqad.com', 'admin@admin.com']
      );
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/khodam/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/khodam/$(request.auth.uid)).data;
    }
    function active() {
      return signedIn() && (
        isConstAdmin()
        || (
          hasProfile()
          && profile().get('status', '') == 'active'
          && profile().get('role', '') in ['stageAdmin', 'gradeAdmin', 'servant']
        )
      );
    }
    function stage() {
      return isConstAdmin() || (hasProfile() && active() && profile().get('role', '') == 'stageAdmin');
    }
    function gradeAdmin(grade) {
      return stage() || (hasProfile() && active() && profile().get('role', '') == 'gradeAdmin' && profile().get('grade', '') == grade);
    }
    function scope(grade) {
      return stage() || (grade != null && gradeAdmin(grade));
    }
    function ownGradeServant(grade) {
      return hasProfile() && active() && profile().get('role', '') == 'servant' && profile().get('grade', '') == grade;
    }
    function assignedChild(data) {
      return hasProfile() && active() && profile().get('role', '') == 'servant'
        && data.get('assignedKhademId', null) == request.auth.uid;
    }
    function childAccess(id) {
      let childPath = /databases/$(database)/documents/makhdomeen/$(id);
      return exists(childPath) && (scope(get(childPath).data.get('grade', '')) || assignedChild(get(childPath).data));
    }
    function assignedTask(data) {
      return active() && (
        data.get('assignedKhademId', null) == request.auth.uid
        || data.get('assignedToId', null) == request.auth.uid
      );
    }
    function attendancePartRead(grade, data) {
      return active() && (
        scope(grade) || ownGradeServant(grade)
        || (data != null && data.get('taskId', null) != null
          && exists(/databases/$(database)/documents/tasks/$(data.taskId))
          && assignedTask(get(/databases/$(database)/documents/tasks/$(data.taskId)).data))
      );
    }
    function visitRead(data) {
      return active() && (
        scope(data.get('grade', null))
        || data.get('khademId', data.get('servantId', null)) == request.auth.uid
        || (data.get('makhdomId', null) != null && childAccess(data.makhdomId))
      );
    }

    match /khodam/{khademId} {
      allow read: if signedIn() && (
        request.auth.uid == khademId || stage()
        || (resource.data.get('grade', null) != null && gradeAdmin(resource.data.get('grade', null)))
      );
      allow create: if signedIn() && (
        isConstAdmin()
        || (
          request.auth.uid == khademId
          && request.resource.data.role == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.get('grade', null) == null
        )
      );
      allow update: if signedIn() && (
        stage()
        || (
          request.auth.uid == khademId
          && (
            isConstAdmin()
            || (
              resource.data.status in ['active', 'pending', 'rejected']
              && request.resource.data.get('grade', null) == resource.data.get('grade', null)
              && (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'phone', 'locale', 'updatedAt'])
                || (
                  resource.data.status in ['pending', 'rejected']
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'phone', 'locale', 'serviceId', 'serviceIds', 'status', 'role', 'rejectionReason', 'updatedAt'])
                  && request.resource.data.role == 'pending'
                  && request.resource.data.status == 'pending'
                )
              )
            )
          )
        )
        || (active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedCount']))
      );
      allow delete: if stage();

      match /devices/{installationId} {
        allow read, delete: if signedIn() && request.auth.uid == khademId;
        allow create, update: if signedIn() && request.auth.uid == khademId;
      }
    }

    match /makhdomeen/{id} {
      allow read: if scope(resource.data.get('grade', '')) || assignedChild(resource.data);
      allow create: if active() && (scope(request.resource.data.get('grade', '')) || isConstAdmin());
      allow update: if active() && (
        scope(resource.data.get('grade', ''))
        || assignedChild(resource.data)
        || isConstAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount', 'lastVisitDate', 'updatedAt'])
      );
      allow delete: if stage();
    }

    match /attendance/{sessionId} {
      allow read: if active();
      allow create, update: if active() && (
        scope(request.resource.data.get('grade', 'all'))
        || ownGradeServant(request.resource.data.get('grade', 'all'))
        || request.resource.data.get('grade', '') == 'all'
        || isConstAdmin()
      );
      allow delete: if stage();

      match /grades/{grade} {
        allow read: if attendancePartRead(grade, resource.data);
        allow create, update: if active() && (
          scope(grade)
          || ownGradeServant(grade)
          || isConstAdmin()
          || (request.resource.data.get('taskId', null) != null
            && exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
            && assignedTask(get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data))
        );
        allow delete: if stage();
      }
    }

    match /{path=**}/grades/{grade} {
      allow read: if active() && (
        scope(resource.data.get('grade', grade)) || ownGradeServant(resource.data.get('grade', grade))
      );
    }

    match /attendance_roster/{id} {
      allow read: if active();
      allow write: if active() && (
        scope(request.resource.data.get('grade', resource.data.get('grade', '')))
        || isConstAdmin()
      );
    }

    match /visits/{id} {
      allow read: if visitRead(resource.data);
      allow create: if active() && (
        scope(request.resource.data.get('grade', ''))
        || request.resource.data.get('khademId', request.resource.data.get('servantId', '')) == request.auth.uid
        || (request.resource.data.get('makhdomId', null) != null && childAccess(request.resource.data.makhdomId))
        || isConstAdmin()
      );
      allow update: if active() && (
        scope(resource.data.get('grade', ''))
        || resource.data.get('khademId', resource.data.get('servantId', '')) == request.auth.uid
        || isConstAdmin()
      );
      allow delete: if stage() || (active() && resource.data.get('khademId', resource.data.get('servantId', '')) == request.auth.uid);
    }

    match /tasks/{id} {
      allow read: if scope(resource.data.get('grade', null)) || assignedTask(resource.data);
      allow create: if active() && (scope(request.resource.data.get('grade', '')) || isConstAdmin());
      allow update: if active() && (
        scope(resource.data.get('grade', null))
        || assignedTask(resource.data)
        || isConstAdmin()
      );
      allow delete: if stage() || (active() && gradeAdmin(resource.data.get('grade', '')));
    }

    match /notifications/{id} {
      allow read: if active() && (resource.data.recipientId == request.auth.uid || stage());
      allow create: if active();
      allow update: if active() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow delete: if active() && (resource.data.recipientId == request.auth.uid || stage());
    }

    match /settings/{docId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/settings/$(docId))
        || isConstAdmin() || stage();
      allow update: if isConstAdmin() || stage();
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if isConstAdmin() || (
        stage() && (
          serviceId == profile().get('serviceId', 'thanawy')
          || (hasProfile() && profile().get('serviceId', '') == serviceId)
        )
      );
      allow delete: if isConstAdmin();
      allow update: if isConstAdmin() || (
        stage() && (
          serviceId == profile().get('serviceId', 'thanawy')
          || (hasProfile() && profile().get('serviceId', '') == serviceId)
        )
      ) || (
        signedIn() && (
          (resource.data.get('adminUids', []) is list && resource.data.adminUids.hasAny([request.auth.uid]))
          || (resource.data.get('adminEmails', []) is list && request.auth.token.email in resource.data.adminEmails)
        )
      );
    }

    match /classes/{classId} {
      allow read: if active();
      allow create, update, delete: if isConstAdmin() || stage() || (
        active() && gradeAdmin(request.resource.data.get('gradeId', resource.data.get('gradeId', '')))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
